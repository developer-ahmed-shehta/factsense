# FactSense MES / IIoT Web Application - Production Environment Configuration
# Copy this file to .env and customize for your deployment

# Django Core
SECRET_KEY=replace-with-a-cryptographically-secure-secret-key-for-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,factsense.internal.factory,0.0.0.0

# Database Configuration (PostgreSQL in production)
# Format: postgresql://user:password@hostname:5432/dbname
DATABASE_URL=postgresql://factsense_user:factory_pass_2026@db:5432/factsense_prod

# Facility & Localization
PLANT_TIMEZONE=Africa/Cairo
DEFAULT_LANGUAGE=en
DEFAULT_CURRENCY=EGP
WORLD_CLASS_OEE_TARGET=85.0

# Telemetry Watchdog
WATCHDOG_TIMEOUT_SECONDS=15
TELEMETRY_INGESTION_RATE_HZ=1

# Industrial AI Copilot (Dual-Engine)
# If GEMINI_API_KEY is provided, Cloud Gemini 1.5 Flash is engaged.
# If omitted or offline, 100% deterministic local heuristic engine is used automatically.
GEMINI_API_KEY=

# Telegram Bot Integration (Shift Reports & Escalation)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=@factsense_cairo_ops

# External ERP Adapter (Odoo 17 JSON-RPC)
ODOO_URL=http://erp.factory.local:8069
ODOO_DB=odoo_prod
ODOO_USER=admin
ODOO_PASSWORD=

# Cache & Redis (Optional / Production)
REDIS_URL=redis://redis:6379/1

